# Vaultwarden backup configuration
# Copy to /etc/vaultwarden-backup/backup.env and fill in real values.
# Permissions: chmod 600 (root only)

# ──────────────── Paths ────────────────

# Where Vaultwarden stores its data (must contain db.sqlite3)
VW_DATA=/DATA/AppData/vaultwarden

# Path to the restic password file
RESTIC_PASSWORD_FILE=/etc/vaultwarden-backup/restic-pw

# Optional: chown restored data to this UID:GID (Vaultwarden container user)
# Find with: docker inspect vaultwarden | grep -i user
VW_UID=1000
VW_GID=1000

# ──────────────── Destinations ────────────────
# Leave any RESTIC_REPO_* variable unset to skip that destination.

# Local HDD (path on this machine)
RESTIC_REPO_LOCAL=/mnt/backup/vw-restic

# Backblaze B2
# Create an Application Key scoped to one bucket with read/write.
RESTIC_REPO_B2=b2:your-bucket-name:/
B2_ACCOUNT_ID=your_b2_key_id
B2_ACCOUNT_KEY=your_b2_application_key

# Cloudflare R2 (S3-compatible)
# Create an API token scoped to one bucket. Account ID is in the URL.
RESTIC_REPO_R2=s3:https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com/your-bucket-name
AWS_ACCESS_KEY_ID=your_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_r2_secret_access_key

# ──────────────── Retention ────────────────

KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=12

# ──────────────── Advanced Restic Options (optional) ────────────────

# Restic compression level (requires restic >= 0.14.0)
# Options: auto, max, off. Default is off/unset if not specified.
# RESTIC_COMPRESSION=auto

# Weekly check read data subset (requires restic >= 0.15.0)
# Defines what percentage of data packs to read and verify weekly.
# Options: e.g. 5%, 10%, 25%, 100%. Set to empty or comment out to check metadata only.
# CHECK_READ_SUBSET=10%

# ──────────────── Monitoring & Notifications (optional) ────────────────

# Healthchecks.io Ping URL
# Create a check and paste its ping URL here. You'll get alerts if
# backups or weekly checks stop running or fail.
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here

# Webhook notifications for Discord, Slack, or Telegram
# WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id
# WEBHOOK_TYPE=discord # Supported types: discord, slack, telegram, generic

